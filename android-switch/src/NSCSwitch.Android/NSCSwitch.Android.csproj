<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <AndroidEnableFastDeployment>false</AndroidEnableFastDeployment>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationTitle>NSC Toolbox Switch</ApplicationTitle>
    <ApplicationId>io.github.anovvoldigoad.nsctoolboxswitch</ApplicationId>
    <ApplicationDisplayVersion>0.3.1</ApplicationDisplayVersion>
    <ApplicationVersion>5</ApplicationVersion>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <ProjectReference Include="../NSCSwitch.Core/NSCSwitch.Core.csproj" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" Color="#162133" />
    <MauiSplashScreen Include="Resources/Splash/splash.svg" Color="#162133" BaseSize="128,128" />
  </ItemGroup>
</Project>
